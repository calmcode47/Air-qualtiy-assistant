# Optional live advisor. Leave blank to run without credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Required with a Gemini API key. Generate with: openssl rand -hex 24
AURA_ADVISOR_ACCESS_CODE=

# Defaults to 3001. The development proxy targets port 3001.
PORT=3001

# Extra permitted request origins, comma-separated, when needed.
# CORS_ORIGIN=https://aura.example.com

# Set only after verifying the forwarded-IP chain.
# AURA_TRUST_PROXY=2
