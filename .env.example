# Defaults to 3001. The development proxy targets this port.
PORT=3001

# Extra permitted request origins, comma-separated, when needed.
# CORS_ORIGIN=https://aura.example.com

# Set to the numeric number of trusted proxy hops in front of Express.
# The deployed Vercel-to-Render route currently uses 4.
# AURA_TRUST_PROXY=4

# Optional server-side generative advice. Leave unset for keyless local guidance.
# Set a new key only in the server environment; never add it to frontend variables.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
