# Defaults to 3001. The development proxy targets this port.
PORT=3001

# Extra permitted request origins, comma-separated, when needed.
# CORS_ORIGIN=https://aura.example.com

# Set this to the observed number of trusted proxy hops in front of Express.
# The /api/health response and logs report forwarded-IP chain length.
# AURA_TRUST_PROXY=

# Optional shared secret required on every API request when set. Configure the
# same random value in Vercel and Render to block direct requests to Render.
# Generate one with: openssl rand -hex 32
# AURA_EDGE_TOKEN=

# Optional server-side generative advice. Leave unset for keyless local guidance.
# Create a new key in Google AI Studio and set it only in the server environment.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Maximum Gemini requests per UTC day across all clients in this server process.
# The default is 10; set 0 to disable Gemini requests.
# AURA_GEMINI_DAILY_LIMIT=10
