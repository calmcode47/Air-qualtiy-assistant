{
  "name": "urban-air-assistant-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,frontend\" -c \"blue,green\" \"npm --prefix server start\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:server": "npm --prefix server start",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend run test && npm --prefix server test",
    "check:contrast": "node scripts/contrast-check.mjs",
    "start": "node server/index.js --production",
    "test:e2e": "npm --prefix frontend run test:smoke"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
